{
  "manifest_version": 3,
  "name": "Fill It",
  "version": "1.0.0",
  "description": "Fills job application forms from data you already gave it. No AI, no network, no account.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
